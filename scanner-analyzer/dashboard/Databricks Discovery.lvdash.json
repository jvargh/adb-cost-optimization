{
  "datasets": [
    {
      "name": "f121ad13",
      "displayName": "workspace_scan_summary",
      "queryLines": [
        "SELECT \r\n",
        "  -- Scan Metadata\r\n",
        "  scan_id,\r\n",
        "  workspace_id,\r\n",
        "  workspace_url,\r\n",
        "  DATE_FORMAT(scan_start_timestamp, 'yyyy-MM-dd HH:mm:ss') as scan_start_timestamp,\r\n",
        "  DATE_FORMAT(scan_end_timestamp, 'yyyy-MM-dd HH:mm:ss') as scan_end_timestamp,\r\n",
        "  ROUND(scan_duration_seconds, 2) as scan_duration_sec,\r\n",
        "  scan_type,\r\n",
        "  -- Top Row - Resource Counts\r\n",
        "  total_clusters,\r\n",
        "  total_jobs,\r\n",
        "  total_pipelines,\r\n",
        "  total_uc_tables,\r\n",
        "  total_warehouses,\r\n",
        "  total_ml_experiments,\r\n",
        "  total_repos,\r\n",
        "  total_serving_endpoints,\r\n",
        "  total_genie_spaces,\r\n",
        "  total_alerts,\r\n",
        "  total_notebooks\r\n",
        "  FROM dbscannercatalog.catalog_inventory.workspace_scan_summary\r\n",
        "  WHERE workspace_id = :workspace_id and scan_id = (SELECT MAX(scan_id) FROM dbscannercatalog.catalog_inventory.workspace_scan_summary where workspace_id = :workspace_id)\r\n",
        "\r\n"
      ],
      "parameters": [
        {
          "displayName": "workspace_id",
          "keyword": "workspace_id",
          "dataType": "STRING",
          "defaultSelection": {}
        }
      ]
    },
    {
      "name": "13e78280",
      "displayName": "workspace_scan_clusters",
      "queryLines": [
        "select * from dbscannercatalog.catalog_inventory.workspace_scan_clusters\r\n",
        "WHERE scan_id = (SELECT MAX(scan_id) FROM dbscannercatalog.catalog_inventory.workspace_scan_summary)\r\n"
      ]
    },
    {
      "name": "ec39577a",
      "displayName": "workspace_scan_uc_tables",
      "queryLines": [
        "select * from dbscannercatalog.catalog_inventory.workspace_scan_uc_tables\r\n",
        "WHERE scan_id = (SELECT MAX(scan_id) FROM dbscannercatalog.catalog_inventory.workspace_scan_summary) and catalog_name<> 'samples'"
      ]
    },
    {
      "name": "2db73e5f",
      "displayName": "workspace_scan_warehouses",
      "queryLines": [
        "select * from dbscannercatalog.catalog_inventory.workspace_scan_warehouses\r\n",
