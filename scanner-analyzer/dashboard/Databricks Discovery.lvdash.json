      "queryLines": [
        "select * from dbscannercatalog.catalog_inventory.workspace_scan_pipelines\r\n",
        "WHERE scan_id = (SELECT MAX(scan_id) FROM dbscannercatalog.catalog_inventory.workspace_scan_pipelines)\r\n"
      ]
    },
