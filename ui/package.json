{
  "name": "adb-cost-assessment-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "UI orchestration and visualization layer for the read-only Azure Databricks cost optimization assessment toolkit.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && python scripts/inline-build.py",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "python mock/generate-fixtures.py"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.1",
    "recharts": "^2.15.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
